<?xml version="1.0" encoding="utf-8"?>
<!-- Fond du widget : leger degrade vertical pour la profondeur, coins
     arrondis genereux, contour discret assorti a la palette. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#F21A1E27"
        android:endColor="#F2141820" />
    <corners android:radius="22dp" />
    <stroke android:width="1dp" android:color="#333A47" />
</shape>
